#!/bin/sh
set -e

if [ -d "$HOME/.local/share/TermiAI-core" ]; then
    rm -rf "$HOME/.local/share/TermiAI-core" || true
fi

echo "Installing Pip dependencies"

pip3 install --break-system-packages termiai || (git clone https://github.com/ericwasepic127/termiai.git $HOME/.local/share/TermiAI-core && cd $HOME/.local/share/TermiAI-core/ && pip install .)

echo "Finishing up ..."

python3 -m termiai.tools > /dev/null || true

exit 0
